POSTGRES_DB=postiz
POSTGRES_USER=postiz
POSTGRES_PASSWORD=change_this_postgres_password
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_characters

POSTIZ_PORT=4007
TEMPORAL_UI_PORT=8082
TEMPORAL_NAMESPACE=postiz
MAIN_URL=http://localhost:4007
DISABLE_REGISTRATION=false

# Local compatibility image which uses the official Postiz image as its base and
# updates Facebook/Instagram OAuth from deprecated Graph API v20.0 to v25.0.
POSTIZ_IMAGE=postiz-facebook-v25:local
POSTIZ_BASE_IMAGE=ghcr.io/gitroomhq/postiz-app:latest

# Optional: enables AI writing inside Postiz Create Post and in custom Admin AI tools.
OPENAI_API_KEY=
